# Scraper Settings
BROWSER=chrome
BROWSER_HEADLESS_MODE=false
BROWSER_IMPLICIT_WAIT=10
BROWSER_LOAD_TIMEOUT=30

# Anti-Bot Settings
MIN_DELAY=2
MAX_DELAY=5
USE_PROXY=false
PROXY_URL=

# Data Settings
DATA_DIR=./data
EXPORT_FORMAT=csv

# Logs Settings
LOG_DIR=./logs
LOG_LEVEL=INFO

# Advanced Settings
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY=5
CONCURRENT_SCRAPERS=1
USER_AGENT_ROTATION=true
